doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    link(rel="stylesheet" href="./styles/global.css")
    title My Shop - product page

  body
    include components/_navbar
    h1.title #{pageTitle}

    .grid(class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6 px-36")
      each product in products
        .card(class="relative flex flex-col overflow-hidden rounded-lg border border-gray-100 bg-white shadow-md")
          a(href=`/products/${product.id}`, class="relative mx-3 mt-3 aspect-square overflow-hidden rounded-xl")
            img(src=product.imageUrl, alt=product.title, class="w-full h-full object-cover")
            span(class="absolute top-0 left-0 m-2 rounded-full bg-black px-2 text-center text-sm font-medium text-white") #{Math.round((1 - product.price / product.originalPrice) * 100)}% OFF
          .card-content(class="mt-4 px-5 pb-5")
            a(href=`/products/${product.id}`)
              h5(class="text-xl tracking-tight text-slate-900") #{product.title}

            .price-section(class="mt-2 mb-5 flex items-center justify-between")
              p
                span(class="text-3xl font-bold text-slate-900") $#{product.price}
                span(class="text-sm text-slate-900 line-through") $#{product.originalPrice}

            .rating(class="flex items-center")
              span(class="text-yellow-500") ★★★★★
              span(class="ml-2 text-xs bg-yellow-200 rounded px-2") 5.0

            a(href="#" class="flex items-center justify-center w-full gap-2 rounded-md bg-slate-900 px-5 py-2 text-sm font-medium text-white hover:bg-gray-700 focus:outline-none focus:ring-4 focus:ring-blue-300")
              svg(class="h-5 w-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2")
                path(stroke-linecap="round" stroke-linejoin="round" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z")
              span Add to cart
    include components/_footer 